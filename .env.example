# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated. Include your server IP and/or domain here.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Usually auto-derived from ALLOWED_HOSTS; set explicitly only if needed.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# Enable ONLY when serving real HTTPS via a domain (see SITE_ADDRESS below).
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# ---------- First admin (auto-created on container start) ----------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---------- First-deploy data (fixtures/seed.json). Default False so
# redeploys never duplicate data. Set True only for the first deploy. ----------
LOAD_SEED=False

# ---------- Gunicorn ----------
GUNICORN_WORKERS=2
GUNICORN_THREADS=2

# ---------- Public entrypoint (read by Caddy) ----------
# Plain IP or local test (HTTP only):   SITE_ADDRESS=:80
# Real domain (automatic HTTPS):        SITE_ADDRESS=example.com
SITE_ADDRESS=:80
# If docker.io is unreachable from your network (e.g. sanctions), use a
# mirror for the Caddy image. Example for Iran:
# CADDY_IMAGE=docker.arvancloud.ir/library/caddy:2-alpine
